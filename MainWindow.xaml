<Window x:Class="WhisprDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisprDesktop"
        Title="Mensayo" Height="780" Width="1200"
        WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ Yellow / Amber Palette ═══ -->
        <SolidColorBrush x:Key="NavRailBg"       Color="#111111"/>
        <SolidColorBrush x:Key="NavIconColor"    Color="#6B7280"/>
        <SolidColorBrush x:Key="NavIconActive"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBg"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarHover"    Color="#FFFAED"/>
        <SolidColorBrush x:Key="SidebarSelected" Color="#FFF3CC"/>
        <SolidColorBrush x:Key="ChatBg"          Color="#FAFAF8"/>
        <SolidColorBrush x:Key="HeaderBg"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputAreaBg"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBoxBg"      Color="#F3F4F6"/>
        <SolidColorBrush x:Key="AccentBrush"     Color="#FFB800"/>
        <SolidColorBrush x:Key="AccentHover"     Color="#E5A600"/>
        <SolidColorBrush x:Key="AccentLight"     Color="#FFF3CC"/>
        <SolidColorBrush x:Key="AccentPale"      Color="#FFFAED"/>
        <SolidColorBrush x:Key="SentBubble"      Color="#FFB800"/>
        <SolidColorBrush x:Key="RecvBubble"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary"     Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary"   Color="#4B5563"/>
        <SolidColorBrush x:Key="TextMuted"       Color="#9BA3AF"/>
        <SolidColorBrush x:Key="Divider"         Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TitleBarBg"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OnlineDot"       Color="#22C55E"/>
        <SolidColorBrush x:Key="HoverOverlay"    Color="#0A000000"/>
        <SolidColorBrush x:Key="ScrollbarThumb"  Color="#D1D5DB"/>
        <SolidColorBrush x:Key="ScrollbarHover"  Color="#9CA3AF"/>

        <local:InitialConverter    x:Key="InitialConverter"/>
        <local:AvatarBrushConverter x:Key="AvatarBrushConverter"/>
        <local:AvatarContentConverter x:Key="AvatarContentConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- ═══ Nav Icon Button (dark rail) ═══ -->
        <Style x:Key="NavIconButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource NavIconColor}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="48"/>
            <Setter Property="Height"           Value="44"/>
            <Setter Property="Margin"           Value="12,4"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <Grid>
                                <Rectangle x:Name="ActiveBar" Width="3" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" Height="0"
                                           Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Margin="-8,0,0,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource NavIconActive}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Ghost Icon Button (header / light areas) ═══ -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="36"/>
            <Setter Property="Height"           Value="36"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Window Chrome Buttons ═══ -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="44"/>
            <Setter Property="Height"           Value="36"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontFamily"       Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Primary Button ═══ -->
        <Style TargetType="Button">
            <Setter Property="Background"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="14,9"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Secondary Button ═══ -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness"  Value="1.5"/>
            <Setter Property="Padding"          Value="14,9"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFB800"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Send Button (yellow circle with dark arrow) ═══ -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Background"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="42"/>
            <Setter Property="Height"           Value="42"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="21">
                            <Path Data="M 4,12 L 20,12 M 14,6 L 20,12 L 14,18"
                                  Stroke="{StaticResource TextPrimary}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC9500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Rounded TextBox ═══ -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="{StaticResource InputBoxBg}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,9" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Rounded PasswordBox ═══ -->
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"       Value="{StaticResource InputBoxBg}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,9" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Chat List Item ═══ -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Margin="6,1" Padding="10">
                            <Grid>
                                <Rectangle x:Name="SelectedBar" Width="3" HorizontalAlignment="Left"
                                           Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Margin="-10,4,0,4"
                                           Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarSelected}"/>
                                <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Thin Scrollbar ═══ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"        Value="6"/>
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBg" Background="{StaticResource ScrollbarThumb}" CornerRadius="3" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background" Value="{StaticResource ScrollbarHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  WINDOW SHELL                                           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Border Background="{StaticResource TitleBarBg}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>   <!-- Custom title bar -->
                <RowDefinition Height="*"/>    <!-- App content     -->
            </Grid.RowDefinitions>

            <!-- ═══ CUSTOM TITLE BAR ═══ -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>  <!-- Above nav rail -->
                    <ColumnDefinition Width="*"/>   <!-- Draggable      -->
                    <ColumnDefinition Width="Auto"/><!-- Window buttons  -->
                </Grid.ColumnDefinitions>

                <!-- Logo mark in top-left -->
                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 6,9 C 8,11 8,13 6,15 M 11,5 C 15,9 15,15 11,19 M 16,1 C 22,7 22,17 16,23"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform"/>
                </Grid>

                <!-- App title + drag zone -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="Mensayo" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  Beta" FontSize="11"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Chrome Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource ChromeButton}"
                            Click="BtnMinimize_Click" ToolTip="Minimize">
                        <Path Data="M 4,0 L 20,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="16" Height="2" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource ChromeButton}"
                            Click="BtnMaximize_Click" ToolTip="Maximize">
                        <Path Data="M 2,2 L 14,2 L 14,14 L 2,14 Z" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Fill="Transparent"
                              Width="12" Height="12" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource ChromeCloseButton}"
                            Click="BtnClose_Click" ToolTip="Close">
                        <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ APP CONTENT ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>   <!-- Nav Rail    -->
                    <ColumnDefinition Width="320"/>  <!-- Chat List   -->
                    <ColumnDefinition Width="*"/>    <!-- Chat Area   -->
                </Grid.ColumnDefinitions>

                <!-- ═══ LOGIN OVERLAY ═══ -->
                <Border x:Name="LoginPanel" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="{StaticResource ChatBg}" Panel.ZIndex="100">
                    <Border Width="400" Padding="38,34" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="White" CornerRadius="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.15" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Logo -->
                            <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Ellipse Fill="{StaticResource AccentBrush}"/>
                                <Path Data="M 6,9 C 8,11 8,13 6,15 M 11,5 C 15,9 15,15 11,19 M 16,1 C 22,7 22,17 16,23"
                                      Stroke="{StaticResource TextPrimary}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="36" Height="36" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Mensayo" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="End-to-end encrypted messaging" FontSize="13"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

                            <TextBlock Text="Server" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6"/>
                            <TextBox x:Name="TxtServerUrl" Style="{StaticResource RoundedTextBox}"
                                     Text="wss://whispr.onrender.com" Margin="0,0,0,14"/>

                            <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6"/>
                            <TextBox x:Name="TxtUsername" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,14"/>

                            <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6"/>
                            <PasswordBox x:Name="TxtPassword" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,22"/>

                            <Button Content="Sign In" Click="BtnLogin_Click" Height="44" FontSize="15" Margin="0,0,0,10"/>
                            <Button Content="Create Account" Click="BtnRegister_Click"
                                    Style="{StaticResource SecondaryButton}" Height="44" FontSize="15"/>

                            <TextBlock x:Name="TxtAuthStatus" Text="" Foreground="#E05555"
                                       Margin="0,14,0,0" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- ═══════════════════════════════════════════════ -->
                <!--  NAV RAIL  (dark pill style)                    -->
                <!-- ═══════════════════════════════════════════════ -->
                <Border Grid.Column="0" Background="{StaticResource NavRailBg}">
                    <DockPanel>
                        <!-- Top nav icons -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                            <!-- Logo -->
                            <Grid Width="44" Height="44" Margin="12,2,12,8">
                                <Border CornerRadius="14" Background="{StaticResource AccentBrush}">
                                    <Path Data="M 6,9 C 8,11 8,13 6,15 M 11,5 C 15,9 15,15 11,19 M 16,1 C 22,7 22,17 16,23"
                                          Stroke="{StaticResource TextPrimary}" StrokeThickness="2.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Chats (active) -->
                            <Button Style="{StaticResource NavIconButton}" ToolTip="Chats">
                                <Grid>
                                    <Rectangle Width="3" HorizontalAlignment="Left" Height="22"
                                               VerticalAlignment="Center" Margin="-8,0,0,0"
                                               Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2"/>
                                    <Path Data="M 2,2 Q 2,0 4,0 L 20,0 Q 22,0 22,2 L 22,14 Q 22,16 20,16 L 8,16 L 2,22 Z"
                                          Fill="White"
                                          Width="22" Height="22" Stretch="Uniform"/>
                                </Grid>
                            </Button>

                            <!-- New Group (placeholder) -->
                            <Button Style="{StaticResource NavIconButton}" ToolTip="New group  (coming soon)" Opacity="0.45">
                                <Path Data="M 9,2 A 4,4 0 1 0 9,10 A 4,4 0 1 0 9,2 M 2,18 C 2,13.6 5.1,11 9,11 C 10.4,11 11.7,11.4 12.7,12.1 M 17,12 L 17,20 M 13,16 L 21,16"
                                      Stroke="{StaticResource NavIconColor}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Button>

                            <!-- Files (placeholder) -->
                            <Button Style="{StaticResource NavIconButton}" ToolTip="Files  (coming soon)" Opacity="0.45">
                                <Path Data="M 4,2 L 14,2 L 20,8 L 20,22 L 4,22 Z M 14,2 L 14,8 L 20,8"
                                      Stroke="{StaticResource NavIconColor}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Button>

                            <!-- Contacts (placeholder) -->
                            <Button Style="{StaticResource NavIconButton}" ToolTip="Contacts  (coming soon)" Opacity="0.45">
                                <Path Data="M 8,5 A 3.5,3.5 0 1 0 8,12 A 3.5,3.5 0 1 0 8,5 M 2,19 C 2,15 4.7,12.5 8,12.5 C 11.3,12.5 14,15 14,19"
                                      Stroke="{StaticResource NavIconColor}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Bottom: Notifications, Settings + Avatar -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                            <!-- Notifications (placeholder) -->
                            <Button Style="{StaticResource NavIconButton}" ToolTip="Notifications  (coming soon)" Opacity="0.45">
                                <Path Data="M 10,2 A 7,7 0 0 0 3,9 C 3,13 1.5,15 1.5,16 L 18.5,16 C 18.5,15 17,13 17,9 A 7,7 0 0 0 10,2 M 8,19 A 2.5,2.5 0 0 0 12,19"
                                      Stroke="{StaticResource NavIconColor}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Button>

                            <!-- Settings (placeholder) -->
                            <Button Style="{StaticResource NavIconButton}" ToolTip="Settings  (coming soon)" Opacity="0.45">
                                <Path Data="M 12,8 A 4,4 0 1 0 12,16 A 4,4 0 1 0 12,8 M 12,2 L 12,4 M 12,20 L 12,22 M 4.2,4.2 L 5.6,5.6 M 18.4,18.4 L 19.8,19.8 M 2,12 L 4,12 M 20,12 L 22,12 M 4.2,19.8 L 5.6,18.4 M 18.4,5.6 L 19.8,4.2"
                                      Stroke="{StaticResource NavIconColor}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Button>

                            <!-- My Avatar pill -->
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="{StaticResource AccentBrush}" Margin="16,6">
                                <TextBlock x:Name="MyAvatarText" Text="W" Foreground="White"
                                           FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════ -->
                <!--  SIDEBAR  (white panel)                         -->
                <!-- ═══════════════════════════════════════════════ -->
                <Border Grid.Column="1" Background="{StaticResource SidebarBg}">
                    <Grid x:Name="MainAppPanel" Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Profile header -->
                            <RowDefinition Height="Auto"/>  <!-- Search / add   -->
                            <RowDefinition Height="*"/>     <!-- Chat list      -->
                        </Grid.RowDefinitions>

                        <!-- Profile Header -->
                        <Border Grid.Row="0" Padding="14,12" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="MyAvatarBorder" Grid.Column="0" Width="42" Height="42"
                                        CornerRadius="21" Background="{StaticResource AccentBrush}">
                                    <TextBlock x:Name="MyAvatarTextSide" Text="W" Foreground="White"
                                               FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtMyUsername" Text="Username" FontWeight="SemiBold"
                                               FontSize="15" Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource OnlineDot}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Online" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Compose new chat -->
                                <Button Grid.Column="2" Style="{StaticResource GhostIconButton}"
                                        ToolTip="New conversation" Click="BtnAddPeer_Click"
                                        Width="32" Height="32">
                                    <Path Data="M 2,4 C 2,3 3,2 4,2 L 20,2 C 21,2 22,3 22,4 L 22,12 C 22,13 21,14 20,14 L 12,14 L 7,19 L 7,14 L 4,14 C 3,14 2,13 2,12 Z M 12,5.5 L 12,10.5 M 9.5,8 L 14.5,8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Search / Add Peer -->
                        <Border Grid.Row="1" Padding="10,8" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource InputBoxBg}" CornerRadius="10">
                                    <Grid>
                                        <TextBox x:Name="TxtAddPeer" Background="Transparent"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 CaretBrush="{StaticResource AccentBrush}"
                                                 BorderThickness="0" FontSize="14"
                                                 VerticalAlignment="Center" Margin="36,9,10,9"
                                                 KeyDown="TxtAddPeer_KeyDown"/>
                                        <!-- Search icon -->
                                        <Path Data="M 10,3 A 7,7 0 1 0 10,17 A 7,7 0 1 0 10,3 M 15,15 L 21,21"
                                              Stroke="{StaticResource TextMuted}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="10,0,0,0" IsHitTestVisible="False"/>
                                        <!-- Placeholder -->
                                        <TextBlock Text="Search or add contact" Foreground="{StaticResource TextMuted}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="38,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtAddPeer}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Width="36" Height="36" Click="BtnAddPeer_Click"
                                        ToolTip="Add contact" Style="{StaticResource GhostIconButton}">
                                    <Path Data="M 5,12 L 19,12 M 12,5 L 12,19"
                                          Stroke="{StaticResource TextPrimary}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Chat List -->
                        <ListBox x:Name="ListChats" Grid.Row="2"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionChanged="ListChats_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar (initial or 2x2 group) + online dot -->
                                        <Grid Grid.Column="0">
                                            <ContentControl Width="46" Height="46" VerticalAlignment="Center"
                                                            Content="{Binding Converter={StaticResource AvatarContentConverter}}"/>
                                            <Border Width="12" Height="12" CornerRadius="6"
                                                    Background="{StaticResource OnlineDot}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    BorderBrush="{StaticResource SidebarBg}" BorderThickness="2"
                                                    Visibility="{Binding IsGroup, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </Grid>

                                        <!-- Name + preview -->
                                        <Grid Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LastMessageTimeText}" FontSize="11"
                                                           Foreground="{StaticResource TextMuted}" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding LastMessagePreview}" FontSize="12"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="140"
                                                           Margin="0,0,6,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding MemberCountText}" FontSize="11"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <Path Data="M 6,9 C 8,11 8,13 6,15 M 11,5 C 15,9 15,15 11,19 M 16,1 C 22,7 22,17 16,23"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Visibility="{Binding LastMessageRead, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Path Data="M 6,9 C 8,11 8,13 6,15 M 11,5 C 15,9 15,15 11,19 M 16,1 C 22,7 22,17 16,23"
                                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Visibility="{Binding ShowReadReceipt, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- Unread badge -->
                                        <Border Grid.Column="2" MinWidth="20" Height="20" Padding="5,0"
                                                CornerRadius="10" Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="{StaticResource TextPrimary}"
                                                       FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════ -->
                <!--  CHAT AREA  (light)                             -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid Grid.Column="2" Background="{StaticResource ChatBg}">

                    <!-- Empty state when no chat is selected -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.35">
                        <Path Data="M 6,9 C 8,11 8,13 6,15 M 11,5 C 15,9 15,15 11,19 M 16,1 C 22,7 22,17 16,23"
                              Stroke="{StaticResource TextMuted}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a chat to start messaging" FontSize="15"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- Active chat panel (floating with subtle shadow) -->
                    <Grid x:Name="ChatAreaPanel" Visibility="Hidden">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270"
                                              Opacity="0.12" Color="#000000"/>
                        </Grid.Effect>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>  <!-- Chat Header  -->
                            <RowDefinition Height="*"/>   <!-- Messages     -->
                            <RowDefinition Height="Auto"/><!-- Input bar    -->
                        </Grid.RowDefinitions>

                        <!-- ── Chat Header ── -->
                        <Border Grid.Row="0" Background="{StaticResource HeaderBg}"
                                BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Peer avatar (group-capable) -->
                                <Border x:Name="ChatAvatarBorder" Grid.Column="0"
                                        Width="40" Height="40" CornerRadius="20"
                                          Background="{StaticResource AccentBrush}"/>

                                <!-- Name + status -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCurrentChat" Text="Select a contact" FontSize="16"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7"
                                                 Fill="{StaticResource OnlineDot}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TxtE2EEStatus" Text="End-to-end encrypted"
                                                   FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Header action buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pin icon -->
                                    <Button Style="{StaticResource GhostIconButton}" ToolTip="Pin" Opacity="0.5">
                                        <Path Data="M 12,17 L 12,22 M 5,17 L 19,17 M 6.5,17 L 6.5,15.5 C 6.5,14 8,13 8,11.5 L 8,6 L 7,6 L 7,2 L 17,2 L 17,6 L 16,6 L 16,11.5 C 16,13 17.5,14 17.5,15.5 L 17.5,17"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <!-- Edit group / share (placeholder) -->
                                    <Button Style="{StaticResource GhostIconButton}" ToolTip="Edit group  (coming soon)" Opacity="0.5">
                                        <Path Data="M 3,17 L 3,21 L 7,21 L 19,9 L 15,5 Z M 13,7 L 17,11"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent"
                                              Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <!-- More options (placeholder) -->
                                    <Button Style="{StaticResource GhostIconButton}" ToolTip="More options  (coming soon)" Opacity="0.5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,3,0"/>
                                            <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,3,0"/>
                                            <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- E2EE badge -->
                                    <Border Background="#1AFFB800" CornerRadius="10" Padding="10,5" Margin="6,0,2,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 12,2 L 4,5 L 4,11 C 4,16.6 7.4,21.7 12,23 C 16.6,21.7 20,16.6 20,11 L 20,5 Z"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                                  Fill="Transparent" Width="13" Height="13" Stretch="Uniform"/>
                                            <TextBlock Text=" E2EE" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── Messages Area ── -->
                        <ScrollViewer Grid.Row="1" x:Name="ScrollMessages"
                                      Background="{StaticResource ChatBg}"
                                      Padding="20,10" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MessagesPanel" VerticalAlignment="Bottom"/>
                        </ScrollViewer>

                        <!-- ── Input Bar ── -->
                        <Border Grid.Row="2" Background="{StaticResource InputAreaBg}"
                                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- Attach    -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Emoji     -->
                                    <ColumnDefinition Width="*"/>     <!-- Text box  -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Mic       -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Send      -->
                                </Grid.ColumnDefinitions>

                                <!-- Attach file (placeholder) -->
                                <Button Grid.Column="0" Style="{StaticResource GhostIconButton}"
                                        ToolTip="Attach file  (coming soon)" Opacity="0.55" Margin="0,0,2,0">
                                    <Path Data="M 21.44,11.05 L 12.25,20.24 A 6,6 0 0 1 3.84,11.83 L 12.69,2.98 A 4,4 0 0 1 18.57,8.86 L 9.72,17.71 A 2,2 0 0 1 6.9,14.89 L 15.11,6.67"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Width="20" Height="20" Stretch="Uniform"/>
                                </Button>

                                <!-- Emoji (placeholder) -->
                                <Button Grid.Column="1" Style="{StaticResource GhostIconButton}"
                                        ToolTip="Emoji  (coming soon)" Opacity="0.55" Margin="0,0,6,0">
                                    <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 M 8,14 C 8.5,16 10,17 12,17 C 14,17 15.5,16 16,14 M 9,9 L 9,9.5 M 15,9 L 15,9.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Width="20" Height="20" Stretch="Uniform"/>
                                </Button>

                                <!-- Message TextBox -->
                                <Border Grid.Column="2" Background="{StaticResource InputBoxBg}" CornerRadius="22">
                                    <Grid>
                                        <TextBox x:Name="TxtMessage" Background="Transparent"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 CaretBrush="{StaticResource AccentBrush}"
                                                 BorderThickness="0" FontSize="14"
                                                 VerticalAlignment="Center" Margin="18,10"
                                                 KeyDown="TxtMessage_KeyDown"
                                                 TextWrapping="Wrap" MaxHeight="120"
                                                 AcceptsReturn="False"/>
                                        <TextBlock Text="Write a Message..." IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextMuted}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="18,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Voice note (placeholder) -->
                                <Button Grid.Column="3" Style="{StaticResource GhostIconButton}"
                                        ToolTip="Voice message  (coming soon)" Opacity="0.55" Margin="6,0,4,0">
                                    <Path Data="M 12,1 A 4,4 0 0 1 16,5 L 16,11 A 4,4 0 0 1 8,11 L 8,5 A 4,4 0 0 1 12,1 M 5,11 C 5,14.9 8.1,18 12,18 C 15.9,18 19,14.9 19,11 M 12,18 L 12,23 M 8,23 L 16,23"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Width="20" Height="20" Stretch="Uniform"/>
                                </Button>

                                <!-- Send button -->
                                <Button Grid.Column="4" Style="{StaticResource SendButton}"
                                        Click="BtnSend_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
