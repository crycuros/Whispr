<Window x:Class="WhisprDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisprDesktop"
        Title="Whispr Desktop" Height="720" Width="1020"
        FontFamily="Segoe UI" Background="#E6EBEE" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Telegram-style palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#3390EC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F81D3"/>
        <SolidColorBrush x:Key="ChatBgBrush" Color="#E6EBEE"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SentBubbleBrush" Color="#EFFDDE"/>
        <SolidColorBrush x:Key="BubbleTextBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A9197"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E0E3E6"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#E8F1FB"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#F1F4F7"/>

        <local:InitialConverter x:Key="InitialConverter"/>
        <local:AvatarBrushConverter x:Key="AvatarBrushConverter"/>

        <!-- Primary button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary outline button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#3390EC14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular icon button -->
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="20" Width="40" Height="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BubbleTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,9" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded PasswordBox -->
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BubbleTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,9" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chat list item -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Margin="6,2" Padding="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern thin scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBg" Background="#C0C8CE" CornerRadius="4" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background" Value="#A0A8B0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- LOGIN OVERLAY -->
        <Border x:Name="LoginPanel" Background="{StaticResource ChatBgBrush}" Panel.ZIndex="10">
            <Border Width="380" Padding="34,30" Background="White" CornerRadius="18"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18" Color="#1A2B3C"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Width="64" Height="64" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource AccentBrush}"/>
                        <Path Data="M 6,9 C 8,11 8,13 6,15 M 11,5 C 15,9 15,15 11,19 M 16,1 C 22,7 22,17 16,23"
                              Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="34" Height="34" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Whispr" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BubbleTextBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,2"/>
                    <TextBlock Text="Private &amp; encrypted messaging" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,22"/>

                    <TextBlock Text="Server URL" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtServerUrl" Style="{StaticResource RoundedTextBox}" Text="wss://whispr.onrender.com" Margin="0,0,0,14"/>

                    <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtUsername" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,20"/>

                    <Button Content="Log in" Click="BtnLogin_Click" Height="42" FontSize="15" Margin="0,0,0,10"/>
                    <Button Content="Create account" Click="BtnRegister_Click" Style="{StaticResource SecondaryButton}" Height="42" FontSize="15"/>

                    <TextBlock x:Name="TxtAuthStatus" Text="" Foreground="#D8000C" Margin="0,14,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- MAIN APP -->
        <Grid x:Name="MainAppPanel" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- My profile header -->
                    <Border Grid.Row="0" Padding="16,14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MyAvatarBorder" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}">
                                <TextBlock x:Name="MyAvatarText" Text="W" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMyUsername" Text="My Username" FontWeight="SemiBold" FontSize="16"
                                           Foreground="{StaticResource BubbleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Online" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Search / add peer -->
                    <Border Grid.Row="1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAddPeer" Grid.Column="0" Style="{StaticResource RoundedTextBox}"/>
                            <TextBlock Text="Search or start a new chat" Grid.Column="0"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="14"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtAddPeer}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="+" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource CircleButton}" Click="BtnAddPeer_Click"/>
                        </Grid>
                    </Border>

                    <!-- Chat list -->
                    <ListBox x:Name="ListChats" Grid.Row="2" SelectionChanged="ListChats_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                            Background="{Binding Username, Converter={StaticResource AvatarBrushConverter}}">
                                        <TextBlock Text="{Binding Username, Converter={StaticResource InitialConverter}}"
                                                   Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BubbleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastMessagePreview}" FontSize="13"
                                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="160" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" MinWidth="20" Height="20" Padding="6,0" CornerRadius="10"
                                            Background="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                            Margin="8,0,4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CHAT AREA -->
            <Grid Grid.Column="1" x:Name="ChatAreaPanel" Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat header -->
                <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ChatAvatarBorder" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentBrush}">
                            <TextBlock x:Name="TxtChatAvatar" Text="?" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentChat" Text="Selected User" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BubbleTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtE2EEStatus" Text="End-to-end encrypted" FontSize="13" Foreground="#4CAF50" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#E8F1FB" CornerRadius="12" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock Text="🔒 Encrypted" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Messages -->
                <ScrollViewer Grid.Row="1" x:Name="ScrollMessages" Background="{StaticResource ChatBgBrush}"
                              Padding="20,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagesPanel" VerticalAlignment="Bottom"/>
                </ScrollViewer>

                <!-- Input area -->
                <Border Grid.Row="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMessage" Grid.Column="0" Style="{StaticResource RoundedTextBox}" FontSize="14"
                                 KeyDown="TxtMessage_KeyDown" ToolTip="Type a message"/>
                        <Button Content="Send" Grid.Column="1" Margin="10,0,0,0" Width="90" Height="40" Click="BtnSend_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
